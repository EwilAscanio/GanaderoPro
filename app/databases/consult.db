CREATE TABLE configuracion (
    id integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    numero_fac integer NOT NULL,
    ultima_vacunacion date NOT NULL,
    codigo_cli integer NOT NULL
);

INSERT INTO configuracion(numero_fac, ultima_vacunacion, codigo_cli) VALUES(1, '2025-04-29', 1);

CREATE TABLE produccionleche (
  id_lec integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  codigo_ani varchar(15) NOT NULL,
  litros_lec decimal(10,2) NOT NULL DEFAULT 0,
  fecha_lec date NOT NULL,
  created_at timestamp DEFAULT CURRENT_TIMESTAMP,
  
  CONSTRAINT fk_produccion_animal 
    FOREIGN KEY (codigo_ani) 
    REFERENCES animal(codigo_ani)
);

CREATE TABLE clientes (
  codigo_cli integer PRIMARY KEY,
  nombre_cli varchar(200) NOT NULL,
  telefono_cli varchar(50) NOT NULL,
  direccion_cli varchar(250) NOT NULL,
  rif_cli varchar(50) NOT NULL,
  email_cli varchar(100) NOT NULL,
  created_at timestamp DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE factura (
  numero_fac integer PRIMARY KEY,
  codigo_cli integer NOT NULL,
  fecha_fac date NOT NULL,
  total_fac decimal(10,2) NOT NULL,
  observaciones_fac varchar(200) NOT NULL,
  CONSTRAINT fk_factura_clientes FOREIGN KEY (codigo_cli) REFERENCES clientes(codigo_cli)
);


CREATE TABLE detalle_factura (
  id_detalle integer GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
  numero_fac integer NOT NULL,
  codigo_ani varchar(15) NOT NULL,
  cantidad_fac integer NOT NULL DEFAULT 1,
  precio_fac decimal(10,2) NOT NULL,
  total_fac decimal(10,2) NOT NULL,
  created_at timestamp DEFAULT CURRENT_TIMESTAMP,
  
  CONSTRAINT fk_detalle_factura 
    FOREIGN KEY (numero_fac) REFERENCES factura(numero_fac),
  CONSTRAINT fk_animal_detalle 
    FOREIGN KEY (codigo_ani) REFERENCES animal(codigo_ani)
);